{
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "ClusterRole",
  "metadata": {
    "name": "agent-executor",
    "labels": {
      "app.kubernetes.io/component": "agent",
      "app.kubernetes.io/managed-by": "policy-controller"
    },
    "annotations": {
      "description": "Grants scoped permission to execute agent operations in production backend environments"
    }
  },
  "rules": [
    {
      "apiGroups": ["agents.example.com"],
      "resources": ["agents"],
      "verbs": ["execute"],
      "resourceNames": [],
      "scope": {
        "labelSelector": {
          "matchLabels": {
            "environment": "production",
            "team": "backend"
          }
        }
      }
    }
  ]
}
---
{
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "ClusterRoleBinding",
  "metadata": {
    "name": "agent-executor-binding",
    "labels": {
      "app.kubernetes.io/component": "agent",
      "app.kubernetes.io/managed-by": "policy-controller"
    }
  },
  "roleRef": {
    "apiGroup": "rbac.authorization.k8s.io",
    "kind": "ClusterRole",
    "name": "agent-executor"
  },
  "subjects": [
    {
      "kind": "Group",
      "name": "backend-deployers",
      "apiGroup": "rbac.authorization.k8s.io"
    }
  ]
}
